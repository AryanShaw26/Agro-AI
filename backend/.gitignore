# ==============================================================================
# AgroAI Backend .gitignore
# Prevents Python bytecode, local databases, secrets, uploads, and heavy weights
# from ever being committed to GitHub.
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Model binary checkpoints
*.pth
*.pt
*.bin
*.onnx
*.safetensors
*.h5
app/models/*.pth
app/models/*.pt
app/models/*.bin
!app/models/*.json

# Environments & Secrets
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# Local Databases & Storage
*.db
*.sqlite
*.sqlite3
agroai.db
uploads/
storage/

# Logs & Test artifacts
*.log
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Generated PDF Reports & Temp files
*.pdf
reports/*.pdf
scratch/
